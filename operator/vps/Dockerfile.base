# Public base for a new Linux x86_64 VPS. Existing compatible bases may be kept.
FROM python:3.12-slim-bookworm@sha256:34386ef0cb081344d7ec1c103ba398e6e9f64e9ab3a1509accc92a4e24a07258
RUN apt-get update && apt-get install -y --no-install-recommends \
    firefox-esr nodejs xvfb openbox x11vnc novnc websockify \
    ca-certificates fonts-liberation dbus-x11 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --uid 1000 --create-home operator
RUN python -m venv /opt/radar-venv \
    && /opt/radar-venv/bin/pip install --no-cache-dir impit==0.14.1
ENV PYTHONDONTWRITEBYTECODE=1
